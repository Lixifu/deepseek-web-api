# 自动识别文本，并为 Linux 部署脚本固定 LF 换行。
* text=auto

*.go      text eol=lf
*.mod     text eol=lf
*.sum     text eol=lf
*.sh      text eol=lf
*.service text eol=lf
Dockerfile text eol=lf
*.conf    text eol=lf
*.cnf     text eol=lf
*.sql     text eol=lf
*.yml     text eol=lf
*.yaml    text eol=lf
*.json    text eol=lf
*.ts      text eol=lf
*.vue     text eol=lf
*.html    text eol=lf
*.md      text eol=lf

*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.woff binary
*.woff2 binary
