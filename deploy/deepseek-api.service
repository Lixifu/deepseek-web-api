[Unit]
Description=DeepSeek Web API (Go)
Wants=network-online.target mariadb.service redis.service
After=network-online.target mariadb.service redis.service

[Service]
Type=simple
User=admin
Group=admin
WorkingDirectory=/home/admin/myworkplace/deepseekapi/deepseek-web-api
EnvironmentFile=/home/admin/myworkplace/deepseekapi/deepseek-web-api/.env
Environment=HOME=/home/admin
ExecStart=/home/admin/myworkplace/deepseekapi/deepseek-web-api/deepseek-api
Restart=always
RestartSec=5
LimitNOFILE=65536
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true

KillSignal=SIGTERM
TimeoutStopSec=30
TimeoutStartSec=120

[Install]
WantedBy=multi-user.target
