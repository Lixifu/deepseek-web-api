# 应用
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info
CORS_ALLOWED_ORIGINS=

# MySQL
MYSQL_DSN=deepseek:deepseek@tcp(localhost:3306)/deepseek_api?charset=utf8mb4&parseTime=true&loc=Local

# Redis
REDIS_ADDR=localhost:6379
REDIS_DB=0
REDIS_SHARED_QUEUE_ENABLED=true
REDIS_QUEUE_KEY_PREFIX=deepseek_web_api

# 浏览器池
BROWSER_POOL_SIZE=4
# 多实例部署时填写所有实例浏览器池容量之和；0 表示等于本实例池容量
BROWSER_CLUSTER_CONCURRENCY=0
BROWSER_QUEUE_MAX_SIZE=100
BROWSER_QUEUE_TIMEOUT_SECONDS=120
BROWSER_QUEUE_LEASE_TTL_SECONDS=60
BROWSER_QUEUE_POLL_INTERVAL_MS=100
BROWSER_HEADLESS=true
BROWSER_STORAGE_DIR=./data/storage_states

# 管理 API
ADMIN_JWT_SECRET=please-change-me
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=please-change-me
ADMIN_LOGIN_RATE_LIMIT_PER_MINUTE=5
AUDIT_ARCHIVE_AFTER_DAYS=90
AUDIT_ARCHIVE_INTERVAL_HOURS=24
AUDIT_ARCHIVE_RETENTION_DAYS=0
AUDIT_ARCHIVE_BATCH_SIZE=1000
AUDIT_EXPORT_MAX_ROWS=10000

# 限流
RATE_LIMIT_PER_MINUTE=60
