# 应用
APP_ENV=development
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=info

# MySQL
MYSQL_DSN=deepseek:deepseek@tcp(localhost:3306)/deepseek_api?charset=utf8mb4&parseTime=true&loc=Local

# Redis
REDIS_ADDR=localhost:6379
REDIS_DB=0

# 浏览器池
BROWSER_POOL_SIZE=4
BROWSER_HEADLESS=true
BROWSER_STORAGE_DIR=./data/storage_states

# 管理 API
ADMIN_JWT_SECRET=please-change-me
ADMIN_DEFAULT_USERNAME=admin
ADMIN_DEFAULT_PASSWORD=please-change-me

# 限流
RATE_LIMIT_PER_MINUTE=60
